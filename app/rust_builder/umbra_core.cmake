# Build umbra_core with cargokit when cargo and core/Cargo.toml are available.
# Otherwise bundle a stub libumbra_core so Flutter desktop builds still link.
function(umbra_bundle_core project_name bundled_var)
  set(_dir "${CMAKE_CURRENT_LIST_DIR}")
  set(_app_dir "")
  foreach(_i RANGE 0 12)
    if(EXISTS "${_dir}/pubspec.yaml" AND EXISTS "${_dir}/rust_builder/cargokit/cmake/cargokit.cmake")
      set(_app_dir "${_dir}")
      break()
    endif()
    get_filename_component(_dir "${_dir}/.." ABSOLUTE)
  endforeach()
  if(_app_dir STREQUAL "")
    message(FATAL_ERROR "Umbra app/ not found from ${CMAKE_CURRENT_LIST_DIR}")
  endif()
  get_filename_component(_core_dir "${_app_dir}/../core" ABSOLUTE)
  get_filename_component(_plugin_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

  find_program(UMBRA_CARGO cargo)
  if(UMBRA_CARGO AND EXISTS "${_core_dir}/Cargo.toml")
    message(STATUS "Umbra: cargokit building ${_core_dir} (libumbra_core)")
    include("${_app_dir}/rust_builder/cargokit/cmake/cargokit.cmake")
    apply_cargokit(${project_name} "${_core_dir}" "umbra_core" "")
    set(${bundled_var} "${${project_name}_cargokit_lib}" PARENT_SCOPE)
  else()
    message(STATUS "Umbra: cargo unavailable; bundling stub libumbra_core. The Dart mock backend still runs.")
    add_library(${project_name} SHARED "${_plugin_dir}/stub/stub.c")
    set_target_properties(${project_name} PROPERTIES OUTPUT_NAME "umbra_core")
    set(${bundled_var} "$<TARGET_FILE:${project_name}>" PARENT_SCOPE)
  endif()
endfunction()
